# Imagem de teste — estende a imagem de produção com infraestrutura de boot test.
# NÃO usar em produção. Construída por: just test-build
# BASE pode ser sobreposto no CI: --build-arg BASE=ghcr.io/owner/image:latest
ARG BASE=localhost/fedora-kde-custom:latest
FROM ${BASE}

# Console serial para o health check escrever resultados capturáveis pelo QEMU
COPY build_files/test/test-kargs.toml /usr/lib/bootc/kargs.d/20-test-console.toml

# Auto-login: arranca a sessão COSMIC sem interação humana. O cosmic-greeter usa
# o greetd; `initial_session` no config.toml faz o autologin do testuser. Sem isto
# o teste cai no greeter, cujo compositor falha no render headless.
COPY build_files/test/greetd-autologin.toml /etc/greetd/config.toml

# Render de software: sem GPU real numa VM headless, o cosmic-comp (wgpu) precisa
# de llvmpipe. O wrapper exporta o env e arranca a sessão (initial_session acima).
COPY build_files/test/cosmic-test-session.sh /usr/libexec/cosmic-test-session

# Utilizador de teste — padrão correto para imagem atómica bootc:
#   sysusers.d declara o utilizador; tmpfiles.d cria o home a partir do skel no primeiro boot
COPY build_files/test/sysusers-testuser.conf /usr/lib/sysusers.d/testuser.conf
COPY build_files/test/tmpfiles-testuser.conf /usr/lib/tmpfiles.d/testuser-home.conf

# Nota: não escrevemos /etc/sudoers.d — o sudo foi removido da imagem (run0).
# O health check corre como root (serviço systemd); o testuser não precisa elevar.
RUN systemd-sysusers /usr/lib/sysusers.d/testuser.conf && \
    echo "testuser:testpass" | chpasswd && \
    rm -rf /run/dnf

# Health check
COPY build_files/test/boot-health-check.sh /usr/lib/bootc-test/boot-health-check.sh
COPY build_files/test/boot-health-check.service /usr/lib/systemd/system/boot-health-check.service

RUN chmod +x /usr/lib/bootc-test/boot-health-check.sh && \
    chmod 644 /usr/lib/systemd/system/boot-health-check.service && \
    chmod +x /usr/libexec/cosmic-test-session && \
    mkdir -p /usr/lib/systemd/system/graphical.target.wants && \
    ln -sf ../boot-health-check.service \
        /usr/lib/systemd/system/graphical.target.wants/boot-health-check.service

RUN bootc container lint
