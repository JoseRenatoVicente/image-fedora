#!/usr/bin/bash
# sd-boot-migrate-enable — opt-in explícito para a migração GRUB → systemd-boot.
#
# A migração troca o bootloader e reescreve o tipo de partição do ESP
# (sd-boot-migrate.service só corre com este flag presente). Requer a MOK do
# projecto já enrolada (ver: sudo mok-enroll) quando Secure Boot está ativo.
set -euo pipefail

err()  { printf '\033[1;31m%s\033[0m\n' "$*" >&2; }
ok()   { printf '\033[1;32m%s\033[0m\n' "$*"; }
warn() { printf '\033[1;33m%s\033[0m\n' "$*"; }
info() { printf '%s\n' "$*"; }

FLAG=/etc/sd-boot-migrate-requested

[[ $EUID -eq 0 ]] || { err "Execute como root (sudo sd-boot-migrate-enable)."; exit 1; }

if [[ -f /boot/efi/.sd-boot-migrated ]]; then
    ok "✓ Já migrado para systemd-boot nesta máquina."
    exit 0
fi

if [[ -f "$FLAG" ]]; then
    ok "✓ Migração já pedida ($FLAG existe)."
else
    touch "$FLAG"
    ok "✓ Migração pedida ($FLAG criado)."
fi

info "A correr sd-boot-migrate.service agora…"
systemctl start sd-boot-migrate.service || true
systemctl status --no-pager sd-boot-migrate.service || true
warn "Se a MOK do projecto ainda não estiver enrolada, a migração foi adiada"
warn "— corra 'sudo mok-enroll', reinicie para confirmar no MokManager, e"
warn "depois corra este comando de novo."
