#!/usr/bin/bash
# tpm2-luks-enroll — enrola a chave LUKS2 do root no TPM2 para auto-unlock.
#
# Operação PÓS-INSTALL: opera no disco LUKS real, por isso NÃO pode ser feita
# na imagem (precisa da passphrase do LUKS para adicionar um keyslot/token).
#
# Política desta imagem (escolhida no build):
#   • auto-unlock (sem PIN) — desbloqueia se o estado de boot bater
#   • Signed PCR Policy no PCR 11 (medição do UKI pelo systemd-stub, NÃO do
#     firmware): o LUKS enrola contra a CHAVE PÚBLICA
#     (/usr/share/secureboot/tpm2-pcr-public.pem), não contra o valor do PCR
#     em si — um UKI novo a cada update do bootc continua a desbloquear sem
#     reenroll, desde que assinado com a mesma chave (ver build-uki.sh).
#     Trocado de PCR 7 (estado do Secure Boot medido pelo FIRMWARE) porque
#     nalguns firmwares de consumo o PCR 7 não é determinístico entre boots
#     — o unseal falha sempre, mesmo sem nada ter mudado.
#
# Requisitos: Secure Boot ATIVO no firmware, TPM 2.0 presente, deployment
# actual já com UKI assinado (ver /usr/libexec/uki-migrate), e a passphrase
# atual do LUKS à mão.
#
# Importante: ao contrário do esquema antigo (PCR 7), este NÃO regenera nada
# localmente — o UKI só é construído e assinado no build da imagem (a chave
# privada nunca sai do CI). Se o deployment actual ainda não tem UKI, este
# script recusa-se a enrolar (ver verificação abaixo).
#
# AVISO — bypass físico conhecido e aceite (trade-off deliberado):
#   PCR 11 mede o UKI completo (kernel+initrd+cmdline), incluindo a linha de
#   comando do kernel — ao contrário do esquema antigo em PCR 7, editar
#   parâmetros de boot AGORA invalida o selo. Mas esta imagem não define
#   password no GRUB/systemd-boot (decisão STIG deliberada — proteger o
#   prompt em todo boot é hostil para uso desktop); o loader.conf do
#   systemd-boot tem `editor no` (ver sd-boot-migrate), o que já bloqueia a
#   edição de kargs no menu de boot pela via normal. Um atacante com acesso
#   FÍSICO e recursos para contornar isso (ex.: substituir o UKI por um não
#   assinado) não seria aceite pelo Secure Boot; substituir por um UKI antigo
#   mas validamente assinado ainda seria aceite pelo TPM — não há proteção
#   contra rollback para um UKI assinado mais antigo.
#   Se o modelo de ameaça incluir acesso físico não confiável, mitigue com
#   `systemd-cryptenroll --tpm2-with-pin=yes` (PIN em cada boot) — não é
#   feito aqui por defeito.
set -euo pipefail

err()  { printf '\033[1;31m%s\033[0m\n' "$*" >&2; }
ok()   { printf '\033[1;32m%s\033[0m\n' "$*"; }
warn() { printf '\033[1;33m%s\033[0m\n' "$*"; }
info() { printf '%s\n' "$*"; }

PCRS="11"
PCR_PUBKEY=/usr/share/secureboot/tpm2-pcr-public.pem

[[ $EUID -eq 0 ]] || { err "Execute como root (sudo tpm2-luks-enroll)."; exit 1; }

if [[ ! -s "$PCR_PUBKEY" ]]; then
    err "Chave pública PCR ausente: $PCR_PUBKEY"
    err "Este deployment não foi construído com suporte a UKI+PCR11 — actualize primeiro."
    exit 1
fi

if ! ls /boot/EFI/Linux/*.efi &>/dev/null; then
    err "Nenhum UKI encontrado em /boot/EFI/Linux/."
    err "Corra 'sudo uki-migrate' primeiro (converte o deployment actual para UKI)."
    exit 1
fi

warn "⚠ AVISO: este enroll é auto-unlock SEM PIN, selado numa Signed PCR Policy"
warn "  no PCR 11 (medição do UKI: kernel+initrd+cmdline). Esta imagem não usa"
warn "  password de GRUB/systemd-boot. Se isso está fora do seu modelo de"
warn "  ameaça, use antes: systemd-cryptenroll --tpm2-device=auto \\"
warn "             --tpm2-public-key=$PCR_PUBKEY --tpm2-public-key-pcrs=$PCRS \\"
warn "             --tpm2-with-pin=yes <dev>  (pede PIN em cada boot)."
info ""

# ── 1. Secure Boot ────────────────────────────────────────────────────────────
if command -v mokutil >/dev/null 2>&1; then
    SB_STATE="$(mokutil --sb-state 2>/dev/null || true)"
    if printf '%s' "$SB_STATE" | grep -qi 'enabled'; then
        ok "✓ Secure Boot ativo."
    else
        warn "⚠ Secure Boot NÃO está ativo ($SB_STATE)."
        warn "  Sem Secure Boot, nada impede um atacante de arrancar um UKI"
        warn "  arbitrário (não assinado) que o TPM ainda liberte a chave."
        warn "  Ative o Secure Boot no firmware antes de confiar neste enroll."
        read -rp "  Continuar mesmo assim? [s/N] " a; [[ "${a,,}" == s ]] || exit 1
    fi
else
    warn "mokutil ausente — não foi possível verificar Secure Boot."
fi

# ── 2. TPM 2.0 ──────────────────────────────────────────────────────────────
if [[ -e /sys/class/tpm/tpm0 ]] && systemd-cryptenroll --tpm2-device=list >/dev/null 2>&1; then
    ok "✓ TPM 2.0 detectado."
    systemd-cryptenroll --tpm2-device=list || true
else
    err "TPM 2.0 não detectado (/sys/class/tpm/tpm0 ausente ou inacessível)."
    exit 1
fi

# ── 3. Descobrir o(s) dispositivo(s) LUKS ───────────────────────────────────
mapfile -t LUKS_DEVS < <(lsblk -rpno NAME,FSTYPE | awk '$2=="crypto_LUKS"{print $1}')
if [[ ${#LUKS_DEVS[@]} -eq 0 ]]; then
    err "Nenhum dispositivo crypto_LUKS encontrado. O disco está cifrado com LUKS2?"
    exit 1
fi

info ""
info "Dispositivos LUKS encontrados:"
for i in "${!LUKS_DEVS[@]}"; do printf '  [%d] %s\n' "$i" "${LUKS_DEVS[$i]}"; done
if [[ ${#LUKS_DEVS[@]} -eq 1 ]]; then
    DEV="${LUKS_DEVS[0]}"
    info "Usando: $DEV"
else
    read -rp "Índice do dispositivo a enrolar: " idx
    DEV="${LUKS_DEVS[$idx]:?índice inválido}"
fi

# ── 4. Confirmação ───────────────────────────────────────────────────────────
info ""
warn "Vai enrolar TPM2 (auto-unlock, PCR $PCRS) em: $DEV"
warn "Será pedida a passphrase ATUAL do LUKS para adicionar o token."
read -rp "Prosseguir? [s/N] " a; [[ "${a,,}" == s ]] || exit 1

# Remove enroll TPM2 antigo (idempotência) e enrola de novo
systemd-cryptenroll --wipe-slot=tpm2 "$DEV" 2>/dev/null || true
systemd-cryptenroll --tpm2-device=auto \
    --tpm2-public-key="$PCR_PUBKEY" --tpm2-public-key-pcrs="$PCRS" \
    "$DEV"
ok "✓ TPM2 enrolado em $DEV (Signed PCR Policy, PCR $PCRS, auto-unlock)."

# ── 5. crypttab: garantir tpm2-device=auto ──────────────────────────────────
# O systemd-cryptsetup recente tenta o token TPM2 automaticamente, mas a opção
# explícita em /etc/crypttab é o caminho documentado e mais fiável.
UUID="$(cryptsetup luksUUID "$DEV" 2>/dev/null || true)"
if [[ -n "$UUID" ]] && [[ -f /etc/crypttab ]] && grep -q "$UUID" /etc/crypttab; then
    if ! grep "$UUID" /etc/crypttab | grep -q 'tpm2-device=auto'; then
        warn "A entrada de /etc/crypttab para este device não tem 'tpm2-device=auto'."
        info "Linha atual:"; grep "$UUID" /etc/crypttab | sed 's/^/  /'
        cp -a /etc/crypttab /etc/crypttab.bak.$(date +%s)
        sed -i "/$UUID/{/tpm2-device=auto/!s/$/,tpm2-device=auto/}" /etc/crypttab
        ok "✓ /etc/crypttab atualizado (backup criado)."
    else
        ok "✓ /etc/crypttab já tem tpm2-device=auto."
    fi
fi

# ── 6. Recovery key (recomendado) ────────────────────────────────────────────
info ""
warn "RECOMENDADO: adicione uma recovery key offline (fallback se o TPM/PCR mudar)."
read -rp "Gerar uma recovery key agora? [S/n] " a
if [[ "${a,,}" != n ]]; then
    systemd-cryptenroll --recovery-key "$DEV"
    warn "⚠ GUARDE esta recovery key OFFLINE (papel/cofre/pendrive cifrado)."
    warn "  Sem ela, um UKI corrompido/mal assinado ou uma chave PCR revogada"
    warn "  pode trancar o disco."
fi

info ""
ok "Concluído. Teste reiniciando: o disco deve abrir sem pedir passphrase."
info "Para inspecionar os slots:  systemd-cryptenroll $DEV"
info "Para ler os PCRs atuais:    tpm2_pcrread sha256:11"
