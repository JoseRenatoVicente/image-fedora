#!/usr/bin/bash
# tpm2-reenroll-check — deteta drift do selo TPM2 (PCR 7) e oferece reenroll.
#
# Complemento a tpm2-first-enroll: aquele corre UMA vez para activar o
# auto-unlock; este corre em TODOS os arranques seguintes e só age quando o
# unseal do TPM2 falhou neste boot (ex.: um update do bootloader via bootupd
# mudou a "Authority" medida em PCR 7, mesmo o kernel/initramfs não sendo
# normalmente relevantes para esse PCR). Nesse caso o systemd-cryptsetup já
# caiu para a passphrase de recovery para chegar até aqui — sem reenroll, TODO
# arranque seguinte volta a pedir a senha manualmente.
#
# Exits imediatamente e em silêncio se:
#   • Ainda não há enroll TPM2 prévio (isso é trabalho do tpm2-first-enroll)
#   • O TPM2 desbloqueou normalmente neste boot (nada a fazer)
set -euo pipefail

err()  { printf '\033[1;31m  %s\033[0m\n' "$*" >&2; }
ok()   { printf '\033[1;32m  %s\033[0m\n' "$*"; }
warn() { printf '\033[1;33m  %s\033[0m\n' "$*"; }
info() { printf '  %s\n' "$*"; }
hr()   { printf '  %s\n' "────────────────────────────────────────────────────"; }

MARKER=/var/lib/tpm2-enrolled

pause_for_user_visibility() {
    local seconds="${1:-5}"
    info "A continuar automaticamente em ${seconds}s..."
    sleep "$seconds"
}

# ── Guard: só faz sentido se já houve um enroll prévio ──────────────────────
[[ -f "$MARKER" ]] || exit 0

# ── Guard: o unseal do TPM2 falhou mesmo neste arranque? ────────────────────
# systemd-cryptsetup regista o erro da tpm2-tss (Esys_Unseal) quando o PCR
# selado já não bate com o estado actual do Secure Boot.
if ! journalctl -b 0 -u 'systemd-cryptsetup@*' --no-pager 2>/dev/null \
        | grep -qiE 'esys_unseal|Esys Finish ErrorCode|tpm2.*unseal.*fail'; then
    exit 0
fi

# ── Descobrir o(s) dispositivo(s) LUKS ──────────────────────────────────────
mapfile -t LUKS_DEVS < <(lsblk -rpno NAME,FSTYPE | awk '$2=="crypto_LUKS"{print $1}')
[[ ${#LUKS_DEVS[@]} -gt 0 ]] || exit 0

TARGET_DEV="${LUKS_DEVS[0]}"

clear
printf '\n\n'
hr
printf '  O TPM2 NÃO CONSEGUIU DESBLOQUEAR O DISCO AUTOMATICAMENTE\n'
hr
printf '\n'
info "Chegou até aqui porque introduziu a senha de recuperação do LUKS."
info "Isto normalmente acontece quando o Secure Boot mudou de estado"
info "(ex.: uma actualização do bootloader) e invalidou o selo TPM2 antigo."
printf '\n'
info "Dispositivo: $TARGET_DEV"
printf '\n'

choice=""
if ! read -rp "  Reenrolar o TPM2 agora com a senha que acabou de usar? [S/n]  " -t 120 choice; then
    printf '\n'
    warn "Tempo esgotado — reenroll adiado."
    warn "Execute 'sudo tpm2-luks-enroll' para reactivar o auto-unlock."
    pause_for_user_visibility 5
    exit 0
fi

if [[ "${choice,,}" == n ]]; then
    printf '\n'
    warn "Reenroll cancelado. O sistema vai continuar a pedir a senha até"
    warn "executar 'sudo tpm2-luks-enroll' manualmente."
    pause_for_user_visibility 5
    exit 0
fi

printf '\n'
info "Será pedida de novo a senha que acabou de usar (LUKS ou recovery key)."
printf '\n'

if systemd-cryptenroll "$TARGET_DEV" 2>/dev/null | grep -q 'tpm2'; then
    info "Removendo token TPM2 antigo antes de reenrolar..."
    systemd-cryptenroll --wipe-slot=tpm2 "$TARGET_DEV" \
        || warn "Não foi possível remover o token TPM2 antigo; tentando adicionar um novo."
    printf '\n'
fi

if ! systemd-cryptenroll --tpm2-device=auto --tpm2-pcrs=7 "$TARGET_DEV"; then
    printf '\n'
    err "Erro ao reenrolar o TPM2 (senha incorrecta ou TPM indisponível)."
    err "Execute 'sudo tpm2-luks-enroll' para tentar novamente."
    pause_for_user_visibility 10
    exit 1
fi

printf '\n'
hr
ok "✓ TPM2 reenrolado com sucesso em $TARGET_DEV"
hr
info "Os próximos arranques voltam a desbloquear automaticamente."
printf '\n'
pause_for_user_visibility 5
printf '\n'
