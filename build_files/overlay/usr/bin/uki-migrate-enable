#!/usr/bin/bash
# uki-migrate-enable — opt-in explícito para a migração BLS → UKI.
#
# A migração muda a entrada de arranque por omissão do systemd-boot
# (uki-migrate.service só corre com este flag presente). Requer um
# deployment já com UKI assinado (bootc upgrade para uma imagem recente) e
# um keyslot LUKS de password/recovery válido — o script recusa-se a agir
# sem isso.
set -euo pipefail

err()  { printf '\033[1;31m%s\033[0m\n' "$*" >&2; }
ok()   { printf '\033[1;32m%s\033[0m\n' "$*"; }
warn() { printf '\033[1;33m%s\033[0m\n' "$*"; }
info() { printf '%s\n' "$*"; }

FLAG=/etc/uki-migrate-requested

[[ $EUID -eq 0 ]] || { err "Execute como root (sudo uki-migrate-enable)."; exit 1; }

if [[ -f /var/lib/uki-migrated ]]; then
    ok "✓ Já migrado para UKI nesta máquina."
    exit 0
fi

if [[ -f "$FLAG" ]]; then
    ok "✓ Migração já pedida ($FLAG existe)."
else
    touch "$FLAG"
    ok "✓ Migração pedida ($FLAG criado)."
fi

info "A correr uki-migrate.service agora…"
systemctl start uki-migrate.service || true
systemctl status --no-pager uki-migrate.service || true
warn "Se ainda não houver UKI neste deployment, a migração foi adiada —"
warn "corra 'sudo bootc upgrade', reinicie, e depois corra este comando de novo."
warn "Após a migração, active o auto-unlock do disco com: sudo tpm2-luks-enroll"
