#!/usr/bin/bash
# tpm2-first-enroll — first-boot assistant to enroll the LUKS root partition
# in the TPM2 chip for automatic unlock (BitLocker-style: only the user login
# password is needed on normal boots; the LUKS passphrase becomes a recovery key).
#
# Exits immediately and silently if:
#   • No TPM2 chip is present (VMs, old hardware)
#   • No LUKS-encrypted device is found (unencrypted installs)
#   • TPM2 is already enrolled on the root LUKS device
#
# PCR 7 binds the seal to Secure Boot state; survives kernel/initramfs updates
# without requiring re-enrollment. Secure Boot MUST be active for PCR 7 to
# provide meaningful protection.
set -euo pipefail

err()  { printf '\033[1;31m  %s\033[0m\n' "$*" >&2; }
ok()   { printf '\033[1;32m  %s\033[0m\n' "$*"; }
warn() { printf '\033[1;33m  %s\033[0m\n' "$*"; }
info() { printf '  %s\n' "$*"; }
hr()   { printf '  %s\n' "────────────────────────────────────────────────────"; }

MARKER=/var/lib/tpm2-enrolled

mark_done() { touch "$MARKER" 2>/dev/null || true; }

refresh_initramfs() {
    if command -v rpm-ostree >/dev/null 2>&1 && rpm-ostree status >/dev/null 2>&1; then
        info "Regenerando initramfs transacional via rpm-ostree..."
        if rpm-ostree initramfs --enable; then
            ok "✓ Initramfs agendado para regeneração no próximo deployment."
            return 0
        fi
        warn "Não foi possível executar 'rpm-ostree initramfs --enable'."
        warn "Execute depois: sudo rpm-ostree initramfs --enable"
        return 1
    fi

    if command -v dracut >/dev/null 2>&1; then
        info "Regenerando initramfs via dracut..."
        dracut --force --regenerate-all
        ok "✓ Initramfs regenerado."
        return 0
    fi

    warn "Nenhum regenerador de initramfs encontrado."
    return 1
}

# ── Guard: TPM2 present ──────────────────────────────────────────────────────
if ! systemd-cryptenroll --tpm2-device=list >/dev/null 2>&1; then
    mark_done; exit 0
fi

# ── Guard: LUKS device(s) present ───────────────────────────────────────────
mapfile -t LUKS_DEVS < <(lsblk -rpno NAME,FSTYPE | awk '$2=="crypto_LUKS"{print $1}')
if [[ ${#LUKS_DEVS[@]} -eq 0 ]]; then
    mark_done; exit 0
fi

# ── Guard: not already enrolled ─────────────────────────────────────────────
TARGET_DEV=""
for dev in "${LUKS_DEVS[@]}"; do
    if ! systemd-cryptenroll "$dev" 2>/dev/null | grep -q 'tpm2'; then
        TARGET_DEV="$dev"
        break
    fi
done
if [[ -z "$TARGET_DEV" ]]; then
    mark_done; exit 0
fi

# ── Interactive setup ────────────────────────────────────────────────────────
clear
printf '\n\n'
hr
printf '  DESBLOQUEIO AUTOMÁTICO DO DISCO VIA TPM2\n'
hr
printf '\n'
info "O disco está cifrado com LUKS."
info "Este assistente activa o desbloqueio automático via chip TPM2 para que"
info "não precise de digitar a senha do disco a cada arranque do sistema."
info "(Comportamento semelhante ao BitLocker no Windows.)"
printf '\n'
info "Após a configuração:"
info "  • Arranques normais  → o TPM2 desbloqueia o disco automaticamente"
info "  • Falha de TPM/UEFI  → use a sua senha LUKS como chave de recuperação"
printf '\n'

if command -v mokutil >/dev/null 2>&1; then
    SB="$(mokutil --sb-state 2>/dev/null || true)"
    if ! printf '%s' "$SB" | grep -qi 'enabled'; then
        warn "Aviso: Secure Boot não está activo."
        warn "Active o Secure Boot no firmware (BIOS/UEFI) para máxima protecção."
        printf '\n'
    fi
fi

info "Dispositivo raiz: $TARGET_DEV"
printf '\n'

# Timeout of 120s so unattended boots are not blocked indefinitely
choice=""
if ! read -rp "  Configurar agora? [S/n]  " -t 120 choice; then
    printf '\n'
    warn "Tempo esgotado — configuração adiada."
    warn "Execute 'sudo tpm2-luks-enroll' para activar manualmente."
    mark_done
    read -rp "  Prima ENTER para continuar..." -t 10 _ || true
    exit 0
fi

if [[ "${choice,,}" == n ]]; then
    printf '\n'
    warn "Configuração cancelada."
    warn "Execute 'sudo tpm2-luks-enroll' para activar mais tarde."
    mark_done
    read -rp "  Prima ENTER para continuar..." -t 10 _ || true
    exit 0
fi

printf '\n'
info "Será pedida a sua senha LUKS actual para adicionar o token TPM2."
info "(É a senha que definiu durante a instalação do sistema.)"
printf '\n'

# Wipe any stale TPM2 slot (idempotency) then enroll
systemd-cryptenroll --wipe-slot=tpm2 "$TARGET_DEV" 2>/dev/null || true

if ! systemd-cryptenroll --tpm2-device=auto --tpm2-pcrs=7 "$TARGET_DEV"; then
    printf '\n'
    err "Erro ao configurar o TPM2 (senha incorrecta ou TPM indisponível)."
    err "Execute 'sudo tpm2-luks-enroll' para tentar novamente após o arranque."
    mark_done
    read -rp "  Prima ENTER para continuar..." -t 30 _ || true
    exit 1
fi

# Ensure /etc/crypttab has tpm2-device=auto for the device
UUID="$(cryptsetup luksUUID "$TARGET_DEV" 2>/dev/null || true)"
if [[ -n "$UUID" ]] && grep -q "$UUID" /etc/crypttab 2>/dev/null; then
    if ! grep "$UUID" /etc/crypttab | grep -q 'tpm2-device=auto'; then
        cp -a /etc/crypttab /etc/crypttab.bak.$(date +%s)
        sed -i "/$UUID/{/tpm2-device=auto/!s/$/,tpm2-device=auto/}" /etc/crypttab
    fi
fi

refresh_initramfs || warn "O próximo boot pode continuar pedindo a senha até o initramfs ser regenerado."

mark_done

printf '\n'
hr
ok "✓ TPM2 configurado com sucesso em $TARGET_DEV"
hr
printf '\n'
info "Os próximos arranques desbloquearão o disco automaticamente."
info ""
warn "IMPORTANTE: a sua senha LUKS é agora a chave de recuperação."
warn "Guarde-a num local seguro fora do computador (papel, cofre, pendrive cifrado)."
warn "Sem ela, uma actualização de firmware que altere o Secure Boot"
warn "pode impedir o acesso ao disco."
printf '\n'
read -rp "  Prima ENTER para terminar e iniciar o sistema... " -t 30 _ || true
printf '\n'
