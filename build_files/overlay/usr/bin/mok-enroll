#!/usr/bin/bash
# mok-enroll — enrola a MOK (Machine Owner Key) do projecto no firmware, para
# que o systemd-bootx64.efi assinado no build (65-secureboot-sign.sh) seja
# confiado pelo Secure Boot nesta máquina.
#
# Passo OBRIGATÓRIO e ÚNICO por máquina antes de sd-boot-migrate poder agir.
# Não pode ser feito remotamente/silenciosamente por design do shim: o
# mokutil agenda o import, mas a confirmação real acontece no ecrã azul do
# MokManager no PRÓXIMO arranque, exigindo confirmação física no teclado.
set -euo pipefail

err()  { printf '\033[1;31m%s\033[0m\n' "$*" >&2; }
ok()   { printf '\033[1;32m%s\033[0m\n' "$*"; }
warn() { printf '\033[1;33m%s\033[0m\n' "$*"; }
info() { printf '%s\n' "$*"; }

CERT=/usr/share/secureboot/MOK.der

[[ $EUID -eq 0 ]] || { err "Execute como root (sudo mok-enroll)."; exit 1; }

[[ -f "$CERT" ]] || {
    err "Certificado ausente: $CERT"
    err "Este build não inclui a MOK do projecto — verifique se"
    err "65-secureboot-sign.sh correu no build desta imagem."
    exit 1
}

if command -v mokutil >/dev/null 2>&1 && mokutil --list-enrolled 2>/dev/null \
        | grep -qi "image-fedora Secure Boot MOK"; then
    ok "✓ A MOK do projecto já está enrolada nesta máquina."
    exit 0
fi

info "Vai agendar o enrollment da MOK do projecto (image-fedora Secure Boot MOK)."
info "Será pedida uma senha ÚNICA e TEMPORÁRIA (só para o próximo arranque —"
info "não é a senha do LUKS nem do seu utilizador)."
info ""
mokutil --import "$CERT"

warn ""
warn "IMPORTANTE: no PRÓXIMO arranque, o ecrã azul do MokManager vai pedir para"
warn "confirmar o enrollment (Enroll MOK → Continue → introduza a senha acima)."
warn "Sem essa confirmação física, o enrollment não se completa."
info ""
info "Depois de confirmado e de volta ao sistema, pode executar:"
info "  sudo /usr/libexec/sd-boot-migrate   # migrar de GRUB para systemd-boot"
