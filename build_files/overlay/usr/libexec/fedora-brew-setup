#!/usr/bin/env bash
set -euo pipefail

BREW_COMMIT="93a25fd2d2fdb86422303c292b9223f84ef23eaf"
BREW_SHA256="17f204b128869ec71e6b650051f1e65ef5b74cf994c2ff8b919103241554dd2f"

safe_run() {
    local url="$1" expected_sha="$2"
    shift 2
    local tmp
    tmp="$(mktemp)"
    trap 'rm -f "$tmp"' RETURN
    curl -fsSL "$url" -o "$tmp"
    local actual_sha
    actual_sha="$(sha256sum "$tmp" | cut -d' ' -f1)"
    if [[ "$actual_sha" != "$expected_sha" ]]; then
        notify-send -a 'Fedora' -i 'dialog-error' -u critical \
            "SHA256 mismatch: $url — instalação cancelada por segurança."
        return 1
    fi
    bash "$tmp" "$@"
}

wait_for_network() {
    local tries=60
    while (( tries > 0 )); do
        if getent hosts raw.githubusercontent.com >/dev/null 2>&1 \
            && getent hosts github.com >/dev/null 2>&1 \
            && getent hosts ghcr.io >/dev/null 2>&1; then
            return 0
        fi
        sleep 2
        ((tries--))
    done
    echo "Network/DNS unavailable after waiting; deferring first-boot setup." >&2
    return 1
}

wait_for_network

notify-send -a 'Fedora' -i 'dialog-information' -u normal \
    'A instalar Homebrew e ferramentas de infra (pode demorar)...' || true

# Homebrew — /home/linuxbrew é criado pelo tmpfiles-homebrew.conf (root:wheel 0775)
# com permissões suficientes para utilizadores do grupo wheel instalarem sem sudo.
if [[ ! -f "/home/linuxbrew/.linuxbrew/bin/brew" ]]; then
    NONINTERACTIVE=1 safe_run \
        "https://raw.githubusercontent.com/Homebrew/install/${BREW_COMMIT}/install.sh" \
        "$BREW_SHA256"
fi

eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"

# Infra tools
brew tap hashicorp/tap
brew tap fluxcd/tap
brew tap siderolabs/tap
brew install gcc
brew install hashicorp/tap/terraform kubernetes-cli
brew install fluxcd/tap/flux
brew install siderolabs/tap/talosctl

notify-send -a 'Fedora' -i 'dialog-information' -u normal \
    'Homebrew e ferramentas de infra instaladas.' || true
