#!/usr/bin/env bash
set -euo pipefail

NVM_VERSION="v0.40.3"
LAZYDOCKER_COMMIT="7e7aadc2071d58031bf2daafca1fbd4093efc23f"
LAZYDOCKER_SHA256="57a1a5ca34097da604e19d3b5d0689a47037604d1ab9f8c1bcd0a63bab427359"
OPENCODE_NPM_VERSION="1.17.3"

safe_run() {
    local url="$1" expected_sha="$2"
    shift 2
    local tmp
    tmp="$(mktemp)"
    trap 'rm -f "$tmp"' RETURN
    curl -fsSL "$url" -o "$tmp"
    local actual_sha
    actual_sha="$(sha256sum "$tmp" | cut -d' ' -f1)"
    if [[ "$actual_sha" != "$expected_sha" ]]; then
        notify-send -a 'Fedora' -i 'dialog-error' -u critical \
            "SHA256 mismatch: $url — instalação cancelada por segurança."
        return 1
    fi
    bash "$tmp" "$@"
}

wait_for_network() {
    local tries=60
    while (( tries > 0 )); do
        if getent hosts raw.githubusercontent.com >/dev/null 2>&1 \
            && getent hosts github.com >/dev/null 2>&1 \
            && getent hosts nodejs.org >/dev/null 2>&1 \
            && getent hosts registry.npmjs.org >/dev/null 2>&1; then
            return 0
        fi
        sleep 2
        ((tries--))
    done
    echo "Network/DNS unavailable after waiting; deferring first-boot setup." >&2
    return 1
}

wait_for_network

notify-send -a 'Fedora' -i 'dialog-information' -u normal \
    'A instalar ferramentas de desenvolvimento (NVM, Node.js, LazyDocker)...' || true

# NVM — não é compatível com set -u (usa variáveis opcionais internamente)
export NVM_DIR="$HOME/.nvm"
if [[ ! -s "$NVM_DIR/nvm.sh" ]]; then
    curl -fsSL "https://raw.githubusercontent.com/nvm-sh/nvm/${NVM_VERSION}/install.sh" | bash
fi
# shellcheck source=/dev/null
set +u
source "$NVM_DIR/nvm.sh"

# Node.js LTS. Install always resolves the remote LTS line and selects it;
# avoid using the unresolved LTS alias before it exists locally.
nvm install --lts --latest-npm
nvm alias default 'lts/*'
nvm use default
set -u

# npm globals
npm install -g pnpm
npm install -g "opencode-ai@${OPENCODE_NPM_VERSION}"

# LazyDocker
if [[ ! -f "$HOME/bin/lazydocker" ]] && [[ ! -f "$HOME/.local/bin/lazydocker" ]]; then
    mkdir -p "$HOME/bin"
    safe_run \
        "https://raw.githubusercontent.com/jesseduffield/lazydocker/${LAZYDOCKER_COMMIT}/scripts/install_update_linux.sh" \
        "$LAZYDOCKER_SHA256"
fi

# Guia de desenvolvimento (user-scoped): aponta para containers por projeto em
# vez de empilhar toolchains na base imutável.
GUIDE_DIR="$HOME/.local/share/fedora-dev-setup"
mkdir -p "$GUIDE_DIR"
cat > "$GUIDE_DIR/guide.md" << 'EOF'
# Ambiente de desenvolvimento

A base é imutável (bootc/atomic). Mantém toolchains e dependências de projeto em
containers, não na imagem.

## Container por projeto (distrobox)
    distrobox create --name dev --image registry.fedoraproject.org/fedora-toolbox:44
    distrobox enter dev

## Toolbox (alternativa)
    toolbox create
    toolbox enter

## Já configurado neste utilizador
- Node.js LTS via NVM (`nvm use default`), pnpm, opencode
- LazyDocker
- Shell zsh com starship, zoxide, direnv, fzf (ver ~/.zshrc)
EOF

notify-send -a 'Fedora' -i 'dialog-information' -u normal \
    'Ferramentas de desenvolvimento instaladas.' || true
