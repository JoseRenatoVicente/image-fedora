# Garante o Core Performance Boost (CPB) do CPU AMD activo em arranque.
# Derivado dos profiles tuned do Bazzite (amd_pstate/cpb_boost=enabled), mas
# implementado como oneshot condicional em vez de tuned: o sysfs cpb_boost só
# existe em CPUs AMD com amd_pstate, e escrevê-lo via tuned numa máquina Intel
# geraria ruído no journal. ConditionPathExists garante que em hardware Intel
# (imagem é mista) a unit é simplesmente ignorada, sem warning.
#
# Em workstation/dev o boost maximiza throughput de compilação. Já costuma vir
# ligado por defeito; isto é seguro/insurance contra perfis ou BIOS que o desliguem.
[Unit]
Description=Enable AMD CPU Core Performance Boost (CPB)
ConditionPathExists=/sys/devices/system/cpu/amd_pstate/cpb_boost
DefaultDependencies=no
After=sysinit.target
Before=multi-user.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/bash -c 'echo 1 > /sys/devices/system/cpu/amd_pstate/cpb_boost'

[Install]
WantedBy=multi-user.target
