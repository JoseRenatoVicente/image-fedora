# STIG RHEL-09-271055/271065/271075/271085 — equivalente KDE das regras GNOME/dconf
# do STIG (que assumem GDM/gsettings). Em /etc/xdg/ aplica-se a TODOS os utilizadores
# (cascata KConfig do system-wide), não só ao skel.
#
# O marcador [$i] torna o grupo IMUTÁVEL (KDE kiosk): o utilizador não pode desativar
# nem alterar o bloqueio — cobre os controlos "must prevent a user from overriding"
# (271060/271070/271080). Timeout em MINUTOS. LockOnResume bloqueia ao retomar.
[Daemon][$i]
Autolock=true
LockGrace=0
LockOnResume=true
Timeout=10
