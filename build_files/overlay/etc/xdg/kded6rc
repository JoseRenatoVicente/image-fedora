# kdedrc — configuração global do daemon KDE (kded6)
#
# wpad-detector: o nome do módulo contém hífen, tornando o caminho D-Bus
# (/modules/wpad-detector) inválido (D-Bus não permite hífen em object paths).
# O .so está instalado mas falha ao registrar no barramento, gerando aviso em
# cada sessão KDE. WPAD (Web Proxy Auto-Discovery) não é usado neste perfil.
[Module-wpad-detector]
autoload=false

# kameleon: módulo kded do Garuda Linux para troca dinâmica de esquema de cores.
# Não está instalado nesta imagem; o plasmashell tenta conectar-se a ele via
# D-Bus por herança de configuração do tema Mokka. Desabilitar evita o aviso
# "could not find kded module with id 'kameleon'" a cada inicialização.
[Module-kameleon]
autoload=false
