## CIS RHEL9 §6.3 — regras de auditoria (subconjunto curado para desktop atómico).
## Carregadas por augenrules no arranque do auditd.
##
## REGRA DE OURO desta lista: só referenciar ficheiros/binários que existem SEMPRE
## nesta imagem. Um `-w` ou `-F path=` sobre algo ausente faz o auditctl emitir um
## erro no boot — violaria o objetivo de zero-warning e poderia falhar o test-boot.
## Por isso NÃO vigiamos /var/log/sudo.log (criado só no 1º uso), lastlog/faillock
## (ainda não existem no load) nem chsh/chfn/pkexec (removidos da imagem).
##
## Modo de falha: -f 1 (printk) e SEM imutabilidade (-e 2) — num desktop queremos
## poder reconfigurar sem reboot; o panic-on-audit-loss (-f 2) é perigoso aqui.

## Reset + buffer + modo de falha
-D
-b 8192
-f 1
--backlog_wait_time 60000

## 6.3.3.1/4 — alterações de data/hora e timezone
-a always,exit -F arch=b64 -S adjtimex,settimeofday,clock_settime -k time-change
-a always,exit -F arch=b32 -S adjtimex,settimeofday,clock_settime -k time-change
-w /etc/localtime -p wa -k time-change

## 6.3.3.2 — modificação de identidade (users/groups/políticas de password)
-w /etc/group -p wa -k identity
-w /etc/passwd -p wa -k identity
-w /etc/gshadow -p wa -k identity
-w /etc/shadow -p wa -k identity
-w /etc/security/pwquality.conf -p wa -k identity
-w /etc/security/pwhistory.conf -p wa -k identity
-w /etc/login.defs -p wa -k identity

## 6.3.3.3 — alterações de rede/hostname/domínio
-a always,exit -F arch=b64 -S sethostname,setdomainname -k system-locale
-a always,exit -F arch=b32 -S sethostname,setdomainname -k system-locale

## 6.3.3.5 — política de MAC (SELinux)
-w /etc/selinux/ -p wa -k MAC-policy

## 6.3.3.14/15 — escopo de privilégios (sudoers)
-w /etc/sudoers -p wa -k scope
-w /etc/sudoers.d/ -p wa -k scope

## 6.3.3.6 — comandos privilegiados (apenas binários presentes nesta imagem)
-a always,exit -F path=/usr/bin/sudo    -F perm=x -F auid>=1000 -F auid!=unset -k privileged
-a always,exit -F path=/usr/bin/su      -F perm=x -F auid>=1000 -F auid!=unset -k privileged
-a always,exit -F path=/usr/bin/passwd  -F perm=x -F auid>=1000 -F auid!=unset -k privileged
-a always,exit -F path=/usr/bin/gpasswd -F perm=x -F auid>=1000 -F auid!=unset -k privileged
-a always,exit -F path=/usr/bin/newgrp  -F perm=x -F auid>=1000 -F auid!=unset -k privileged
-a always,exit -F path=/usr/bin/chage   -F perm=x -F auid>=1000 -F auid!=unset -k privileged
-a always,exit -F path=/usr/sbin/usermod -F perm=x -F auid>=1000 -F auid!=unset -k privileged
-a always,exit -F path=/usr/bin/mount   -F perm=x -F auid>=1000 -F auid!=unset -k privileged
-a always,exit -F path=/usr/bin/umount  -F perm=x -F auid>=1000 -F auid!=unset -k privileged

## 6.3.3.7 — montagem de sistemas de ficheiros
-a always,exit -F arch=b64 -S mount -F auid>=1000 -F auid!=unset -k mounts
-a always,exit -F arch=b32 -S mount -F auid>=1000 -F auid!=unset -k mounts

## 6.3.3.19 — carregamento/descarregamento de módulos do kernel
-a always,exit -F arch=b64 -S init_module,finit_module,delete_module -k modules
-a always,exit -F arch=b32 -S init_module,finit_module,delete_module -k modules

## 6.3.3.9 — alterações de permissões DAC (chmod/chown/xattr) por utilizadores reais
-a always,exit -F arch=b64 -S chmod,fchmod,fchmodat -F auid>=1000 -F auid!=unset -k perm_mod
-a always,exit -F arch=b32 -S chmod,fchmod,fchmodat -F auid>=1000 -F auid!=unset -k perm_mod
-a always,exit -F arch=b64 -S chown,fchown,fchownat,lchown -F auid>=1000 -F auid!=unset -k perm_mod
-a always,exit -F arch=b32 -S chown,fchown,fchownat,lchown -F auid>=1000 -F auid!=unset -k perm_mod
-a always,exit -F arch=b64 -S setxattr,lsetxattr,fsetxattr,removexattr,lremovexattr,fremovexattr -F auid>=1000 -F auid!=unset -k perm_mod
-a always,exit -F arch=b32 -S setxattr,lsetxattr,fsetxattr,removexattr,lremovexattr,fremovexattr -F auid>=1000 -F auid!=unset -k perm_mod

## 6.3.3.10 — tentativas de acesso a ficheiros sem permissão
-a always,exit -F arch=b64 -S open,openat,truncate,ftruncate,creat -F exit=-EACCES -F auid>=1000 -F auid!=unset -k access
-a always,exit -F arch=b64 -S open,openat,truncate,ftruncate,creat -F exit=-EPERM  -F auid>=1000 -F auid!=unset -k access
-a always,exit -F arch=b32 -S open,openat,truncate,ftruncate,creat -F exit=-EACCES -F auid>=1000 -F auid!=unset -k access
-a always,exit -F arch=b32 -S open,openat,truncate,ftruncate,creat -F exit=-EPERM  -F auid>=1000 -F auid!=unset -k access

## 6.3.3.17 — eliminação/renomeação de ficheiros pelo utilizador
-a always,exit -F arch=b64 -S unlink,unlinkat,rename,renameat -F auid>=1000 -F auid!=unset -k delete
-a always,exit -F arch=b32 -S unlink,unlinkat,rename,renameat -F auid>=1000 -F auid!=unset -k delete
