# KWin's libinput backend reads [Libinput][Defaults][Touchpad|Pointer|Keyboard]
# as the fallback applied to every device of that class (before any per-device
# override under [Libinput][<vendor>][<product>][<device name>]). The old
# [Libinput][default] key here was never read by KWin — it matched nothing,
# so touchpads silently fell back to raw libinput hardware defaults (natural
# scroll off on most touchpads).
[Libinput][Defaults][Touchpad]
NaturalScroll=true
PointerAcceleration=0.45

[Libinput][Defaults][Pointer]
NaturalScroll=true
PointerAcceleration=0.45

[Mouse]
cursorTheme=catppuccin-mocha-mauve-cursors
