[Unit]
Description=Fedora Shell First-Boot Setup (Oh My Zsh, Powerlevel10k)
Wants=network-online.target
After=network-online.target
ConditionUser=!@system
ConditionPathIsDirectory=/var/home/%u
ConditionPathExists=!%E/fedora/fedora-shell-setup.stamp

[Service]
Type=oneshot
ExecStart=/usr/libexec/fedora-shell-setup
ExecStartPost=/bin/bash -c 'cfg="${XDG_CONFIG_HOME:-$HOME/.config}/fedora"; mkdir -p "$cfg" && touch "$cfg/fedora-shell-setup.stamp"'
Restart=on-failure
RestartSec=30s
RestartMaxDelaySec=1800s
RestartSteps=10
