#!/usr/bin/env bash
set -euo pipefail

# shellcheck source=fedora-setup-common.sh
source /usr/libexec/fedora-setup-common.sh

BREW_COMMIT="93a25fd2d2fdb86422303c292b9223f84ef23eaf"
BREW_SHA256="17f204b128869ec71e6b650051f1e65ef5b74cf994c2ff8b919103241554dd2f"

notify-send -a 'Fedora' -i 'dialog-information' -u normal \
    'A instalar Homebrew e ferramentas de infra (pode demorar)...'

# Homebrew — /home/linuxbrew é criado pelo tmpfiles-homebrew.conf (root:wheel 0775)
# com permissões suficientes para utilizadores do grupo wheel instalarem sem sudo.
if [[ ! -f "/home/linuxbrew/.linuxbrew/bin/brew" ]]; then
    NONINTERACTIVE=1 safe_run \
        "https://raw.githubusercontent.com/Homebrew/install/${BREW_COMMIT}/install.sh" \
        "$BREW_SHA256"
fi

eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"

# Infra tools
brew install terraform kubernetes-cli || true
brew install fluxcd/tap/flux          || true
brew install siderolabs/tap/talosctl  || true

notify-send -a 'Fedora' -i 'dialog-information' -u normal \
    'Homebrew e ferramentas de infra instaladas.'
