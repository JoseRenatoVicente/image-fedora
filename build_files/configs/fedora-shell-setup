#!/usr/bin/env bash
set -euo pipefail

# Configura o zsh com starship (prompt) + plugins do sistema.
# Substitui Oh My Zsh + Powerlevel10k: o starship vem baked em /usr/bin
# (install-assets.sh) e os plugins zsh-autosuggestions/zsh-syntax-highlighting
# vêm como RPMs Fedora — zero downloads no primeiro boot.

notify-send -a 'Fedora' -i 'dialog-information' -u normal \
    'A configurar shell (starship)...'

ZSHRC="$HOME/.zshrc"

# .zshrc é regenerado a partir de um marcador idempotente. Conteúdo do utilizador
# antes do marcador é preservado; o nosso bloco é reescrito a cada execução.
MARKER="# >>> fedora-shell-setup >>>"
END_MARKER="# <<< fedora-shell-setup <<<"

# Remove um bloco gerido anterior (entre marcadores), preservando o resto.
if [[ -f "$ZSHRC" ]] && grep -qF "$MARKER" "$ZSHRC"; then
    sed -i "/^${MARKER}\$/,/^${END_MARKER}\$/d" "$ZSHRC"
fi

cat >> "$ZSHRC" << 'EOF'
# >>> fedora-shell-setup >>>
# Bloco gerido automaticamente — editar fora destes marcadores.

# História
HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000
setopt SHARE_HISTORY HIST_IGNORE_DUPS HIST_IGNORE_SPACE HIST_REDUCE_BLANKS EXTENDED_HISTORY

# Completion
autoload -Uz compinit && compinit -d "${XDG_CACHE_HOME:-$HOME/.cache}/zcompdump"
zstyle ':completion:*' menu select

# Autosuggestions (RPM zsh-autosuggestions)
[[ -r /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]] \
    && source /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh

# Aliases alinhados com o modelo Atomic/Podman
alias docker='podman'
alias docker-compose='podman-compose'
alias ls='eza --icons'
alias ll='eza -la --icons'
alias lt='eza --tree --icons'
alias grep='grep --color=auto'
alias update='rpm-ostree upgrade'

# Esc-Esc: alterna sudo/run0 no início da linha actual.
sudo-command-line() {
    [[ -z $BUFFER ]] && zle up-history
    local elev="sudo"
    command -v run0 >/dev/null 2>&1 && elev="run0"
    if [[ $BUFFER == sudo\ * ]]; then
        BUFFER="${BUFFER#sudo }"
    elif [[ $BUFFER == run0\ * ]]; then
        BUFFER="${BUFFER#run0 }"
    else
        BUFFER="$elev $BUFFER"
    fi
    zle end-of-line
}
zle -N sudo-command-line
bindkey '\e\e' sudo-command-line

# fj: escolhe uma recipe just com fzf e executa.
fj() {
    command -v just >/dev/null 2>&1 || { print -u2 'fj: just não encontrado'; return 1; }
    command -v fzf >/dev/null 2>&1 || { print -u2 'fj: fzf não encontrado'; return 1; }
    local recipe
    recipe=$(just --summary 2>/dev/null | tr ' ' '\n' | fzf --prompt='just> ' --height=40% --reverse) \
        && just "$recipe"
}

# fgb: escolhe branch git com fzf e faz checkout.
fgb() {
    command -v git >/dev/null 2>&1 || { print -u2 'fgb: git não encontrado'; return 1; }
    command -v fzf >/dev/null 2>&1 || { print -u2 'fgb: fzf não encontrado'; return 1; }
    local branch
    branch=$(git branch --all 2>/dev/null | sed 's/^[* ]*//; s#remotes/[^/]*/##' \
        | grep -v '^HEAD' | sort -u | fzf --height=40% --reverse) \
        && git checkout "$branch"
}

# NVM
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && source "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && source "$NVM_DIR/bash_completion"

# Homebrew
eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv 2>/dev/null || true)"

# Prompt e navegação: inicialização condicional, sem downloads.
command -v starship >/dev/null 2>&1 && eval "$(starship init zsh)"
command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init zsh)"
command -v direnv >/dev/null 2>&1 && eval "$(direnv hook zsh)"

# Syntax highlighting (RPM zsh-syntax-highlighting) — DEVE ser o último source
[[ -r /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]] \
    && source /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
# <<< fedora-shell-setup <<<
EOF

notify-send -a 'Fedora' -i 'dialog-information' -u normal \
    'Shell configurada com sucesso.'
