#!/usr/bin/env bash
set -euo pipefail

# shellcheck source=fedora-setup-common.sh
source /usr/libexec/fedora-setup-common.sh

NVM_VERSION="v0.40.3"
NVM_SHA256="2d8359a64a3cb07c02389ad88ceecd43f2fa469c06104f92f98df5b6f315275f"
LAZYDOCKER_COMMIT="7e7aadc2071d58031bf2daafca1fbd4093efc23f"
LAZYDOCKER_SHA256="57a1a5ca34097da604e19d3b5d0689a47037604d1ab9f8c1bcd0a63bab427359"
OPENCODE_NPM_VERSION="1.17.3"

notify-send -a 'Fedora' -i 'dialog-information' -u normal \
    'A instalar ferramentas de desenvolvimento (NVM, Node.js, LazyDocker)...'

# NVM — checksum verificado (antes era curl|bash sem verificação de integridade)
export NVM_DIR="$HOME/.nvm"
if [[ ! -s "$NVM_DIR/nvm.sh" ]]; then
    safe_run \
        "https://raw.githubusercontent.com/nvm-sh/nvm/${NVM_VERSION}/install.sh" \
        "$NVM_SHA256"
fi
# shellcheck source=/dev/null
source "$NVM_DIR/nvm.sh"

# Node.js LTS
if ! nvm ls --no-colors 2>/dev/null | grep -qE '\->' ; then
    nvm install --lts
fi
nvm use --lts
nvm alias default node

# npm globals
npm install -g pnpm || true
npm install -g "opencode-ai@${OPENCODE_NPM_VERSION}" || true

# LazyDocker
if [[ ! -f "$HOME/bin/lazydocker" ]] && [[ ! -f "$HOME/.local/bin/lazydocker" ]]; then
    mkdir -p "$HOME/bin"
    safe_run \
        "https://raw.githubusercontent.com/jesseduffield/lazydocker/${LAZYDOCKER_COMMIT}/scripts/install_update_linux.sh" \
        "$LAZYDOCKER_SHA256"
fi

# Guia local para toolchains pesadas: manter fora da base imutável.
GUIDE_DIR="$HOME/.local/share/fedora-dev-setup"
mkdir -p "$GUIDE_DIR"
cat > "$GUIDE_DIR/containers.md" <<'EOF'
# Fedora Dev Containers

Use Distrobox or Toolbox for language runtimes, SDKs, Kubernetes/Terraform CLIs,
and project-specific build tools. Keep the immutable base small.

Recommended Distrobox:

```bash
distrobox create --name dev --image registry.fedoraproject.org/fedora-toolbox:44
distrobox enter dev
```

Alternative Toolbox:

```bash
toolbox create --release 44 dev
toolbox enter dev
```

Install high-churn tooling inside the container, for example:

```bash
sudo dnf install -y nodejs npm python3 python3-pip go rust cargo terraform ansible kubernetes-client
```
EOF

notify-send -a 'Fedora' -i 'dialog-information' -u normal \
    'Ferramentas de desenvolvimento instaladas.'
