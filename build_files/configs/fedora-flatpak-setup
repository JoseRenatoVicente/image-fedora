#!/usr/bin/env bash
set -euo pipefail

in_progress="${XDG_CACHE_HOME:-$HOME/.cache}/fedora-flatpak-setup-in-progress"
if [[ ! -f "${in_progress}" ]]; then
    notify-send -a 'Fedora' -i 'dialog-information' -u normal 'A instalar Flatpaks, aguarde...'
fi
touch "${in_progress}"

flatpak remote-add --if-not-exists --user flathub \
    https://flathub.org/repo/flathub.flatpakrepo

FLATPAKS=(
    com.discordapp.Discord
    org.telegram.desktop
    md.obsidian.Obsidian
    io.dbeaver.DBeaverCommunity
    com.slack.Slack
    org.qbittorrent.qBittorrent
    com.github.IsmaelMartinez.teams_for_linux
    org.torproject.torbrowser-launcher
    com.heroicgameslauncher.hgl
    com.valvesoftware.Steam
    com.google.Chrome
    org.videolan.VLC
    net.lutris.Lutris
)

for pkg in "${FLATPAKS[@]}"; do
    flatpak install --user -y flathub "$pkg" \
        || notify-send -a 'Fedora' -i 'dialog-warning' -u normal "Flatpak falhou: $pkg"
done

notify-send -a 'Fedora' -i 'dialog-information' -u normal 'Flatpaks instalados com sucesso.'
rm -f "${in_progress}"
