#!/usr/bin/bash
# Blocks 'wpctl clear-default' when invoked from Steam.
# Without this, Steam resets the system audio default on every launch,
# causing audio to stop working on the desktop after closing Steam.
# Mirrors Nobara's wireplumber patch (block_steam_clear_default).

if [[ "$1" == "clear-default" ]]; then
    ppid=$(awk '/^PPid:/{print $2}' "/proc/$PPID/status" 2>/dev/null)
    if [[ -n "$ppid" ]]; then
        grandparent=$(cat "/proc/$ppid/comm" 2>/dev/null)
        if [[ "$grandparent" == "steam" ]]; then
            echo "wpctl clear-default: blocked (called from Steam)" >&2
            exit 0
        fi
    fi
fi

exec /usr/bin/wpctl.real "$@"
