#!/usr/bin/env bash
# fedora-initial-setup — Wrapper para executar setup-user.sh com prompt inteligente
# Roda uma única vez no primeiro login (via systemd user service)
# Estado persistido em ~/.local/share/fedora-kde-setup/.setup-prompted

set -euo pipefail

STATE_DIR="$HOME/.local/share/fedora-kde-setup"
STATE_FILE="$STATE_DIR/.setup-prompted"

mkdir -p "$STATE_DIR"

# Se já foi executado (ou usuário skipped), sair silenciosamente
if [[ -f "$STATE_FILE" ]]; then
  exit 0
fi

# Prompt inteligente
echo ""
printf "\033[1;36m%s\033[0m\n" "╔════════════════════════════════════════════════════════════════╗"
printf "\033[1;36m%s\033[0m\n" "║                 🚀 Fedora KDE Initial Setup                    ║"
printf "\033[1;36m%s\033[0m\n" "║                                                                ║"
printf "\033[1;36m%s\033[0m\n" "║  Instala: NVM/Node.js, Oh My Zsh, Powerlevel10k, LazyDocker,   ║"
printf "\033[1;36m%s\033[0m\n" "║           Homebrew, terraform, kubectl, flux, talosctl         ║"
printf "\033[1;36m%s\033[0m\n" "║           Flatpaks (Discord, Telegram, Steam, Chrome, etc)    ║"
printf "\033[1;36m%s\033[0m\n" "║                                                                ║"
printf "\033[1;36m%s\033[0m\n" "╚════════════════════════════════════════════════════════════════╝"
echo ""
read -rp "  Executar setup agora? [S/n] " resp
echo ""

if [[ "${resp,,}" == "n" ]]; then
  printf "\033[1;33m%s\033[0m\n" "⏭️  Setup pulado. Para executar depois: bash ~/setup-user.sh"
  echo ""
  touch "$STATE_FILE"
  exit 0
fi

# Executa setup interativo
printf "\033[1;32m%s\033[0m\n" "▶️  Iniciando setup..."
echo ""
bash "$HOME/setup-user.sh"

# Marca como executado
touch "$STATE_FILE"
exit 0
