[Unit]
Description=Fedora KDE Initial User Setup
Documentation=man:fedora-initial-setup(1)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=oneshot
ExecStart=/usr/bin/kitty --hold -e %h/.local/bin/fedora-initial-setup
RemainAfterExit=yes

[Install]
WantedBy=graphical-session.target
