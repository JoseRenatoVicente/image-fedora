[Unit]
Description=Fedora Dev First-Boot Setup (NVM, Node.js, LazyDocker)
Wants=network-online.target
After=network-online.target
ConditionUser=!@system
ConditionPathIsDirectory=/var/home/%u
ConditionPathExists=!%E/fedora/fedora-dev-setup.stamp

[Service]
Type=oneshot
ExecStart=/usr/libexec/fedora-dev-setup
ExecStartPost=/bin/bash -c 'cfg="${XDG_CONFIG_HOME:-$HOME/.config}/fedora"; mkdir -p "$cfg" && touch "$cfg/fedora-dev-setup.stamp"'
Restart=on-failure
RestartSec=30s
RestartMaxDelaySec=1800s
RestartSteps=10
