[Unit]
Description=Boot Health Check (imagem de teste)
# Só existe na imagem de teste; nunca presente na imagem de produção.
# Corre após graphical.target para que cosmic-greeter + autologin + sessão
# COSMIC já tenham arrancado — o health check aguarda o cosmic-comp do
# testuser e depois varre o journal (sistema + sessão) por erros e avisos.
After=graphical.target
Wants=graphical.target

[Service]
Type=oneshot
# Aguarda os serviços estabilizarem após o boot
ExecStartPre=/bin/sleep 5
ExecStart=/usr/lib/bootc-test/boot-health-check.sh
# Desliga a VM após o relatório (o QEMU captura o serial e termina)
ExecStartPost=/usr/bin/systemctl poweroff --force
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=graphical.target
